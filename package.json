{
  "name": "dougs-api-client",
  "version": "2.1.0",
  "description": "A TypeScript client for easy interaction with Dougs.fr accounting data",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dougs-mcp-server": "dist/mcp/server.js"
  },
  "scripts": {
    "prepare": "npm run build",
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "start": "node dist/mcp/server.js",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js",
    "dev": "ts-node src/mcp/server.ts"
  },
  "keywords": [
    "dougs",
    "api",
    "client",
    "typescript",
    "wrapper",
    "mcp",
    "model-context-protocol"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verdier/dougs-api-client.git"
  },
  "bugs": {
    "url": "https://github.com/verdier/dougs-api-client/issues"
  },
  "homepage": "https://github.com/verdier/dougs-api-client#readme",
  "files": [
    "dist",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
